# Masukkan Token Bot Telegram yang didapat dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Masukkan Google Gemini API Key dari https://aistudio.google.com/
GEMINI_API_KEY=

# Model Gemini yang digunakan (default: gemini-2.5-flash untuk respon super cepat dan hemat)
GEMINI_MODEL=gemini-2.5-flash

# Aktifkan balasan suara otomatis ketika pengguna mengirim voice note (true / false)
VOICE_REPLY_ENABLED=true

# Pilihan suara Text-To-Speech bahasa Indonesia:
# - id-ID-GadisNeural (Wanita, ramah & natural)
# - id-ID-ArdiNeural (Pria, tegas & natural)
TTS_VOICE=id-ID-GadisNeural
